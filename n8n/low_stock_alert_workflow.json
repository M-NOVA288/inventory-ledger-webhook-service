{
  "name": "Low Stock Alert Router",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "inventory-low-stock",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "a1f0c9d2-0001-4b8e-9b1a-000000000001",
      "name": "Inventory Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "inventory-low-stock"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.body.severity }}",
              "rightValue": "critical",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1f0c9d2-0002-4b8e-9b1a-000000000002",
      "name": "Out of Stock?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": { "__rl": true, "value": "#supply-chain-urgent", "mode": "name" },
        "text": "=:rotating_light: OUT OF STOCK: {{ $('Inventory Webhook').item.json.body.message }}",
        "otherOptions": {}
      },
      "id": "a1f0c9d2-0003-4b8e-9b1a-000000000003",
      "name": "Slack - Urgent Channel",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [740, 180]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": { "__rl": true, "value": "#inventory-alerts", "mode": "name" },
        "text": "=:warning: Reorder needed: {{ $('Inventory Webhook').item.json.body.message }}",
        "otherOptions": {}
      },
      "id": "a1f0c9d2-0004-4b8e-9b1a-000000000004",
      "name": "Slack - Inventory Channel",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [740, 420]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "__rl": true, "value": "REPLACE_WITH_SHEET_ID", "mode": "id" },
        "sheetName": { "__rl": true, "value": "Alert Log", "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "alert_id": "={{ $('Inventory Webhook').item.json.body.alert_id }}",
            "site": "={{ $('Inventory Webhook').item.json.body.site_code }}",
            "sku": "={{ $('Inventory Webhook').item.json.body.sku }}",
            "on_hand": "={{ $('Inventory Webhook').item.json.body.on_hand }}",
            "reorder_point": "={{ $('Inventory Webhook').item.json.body.reorder_point }}",
            "severity": "={{ $('Inventory Webhook').item.json.body.severity }}",
            "received_at": "={{ $now.toISO() }}"
          }
        },
        "options": {}
      },
      "id": "a1f0c9d2-0005-4b8e-9b1a-000000000005",
      "name": "Log to Google Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1000, 300]
    }
  ],
  "connections": {
    "Inventory Webhook": {
      "main": [[{ "node": "Out of Stock?", "type": "main", "index": 0 }]]
    },
    "Out of Stock?": {
      "main": [
        [{ "node": "Slack - Urgent Channel", "type": "main", "index": 0 }],
        [{ "node": "Slack - Inventory Channel", "type": "main", "index": 0 }]
      ]
    },
    "Slack - Urgent Channel": {
      "main": [[{ "node": "Log to Google Sheet", "type": "main", "index": 0 }]]
    },
    "Slack - Inventory Channel": {
      "main": [[{ "node": "Log to Google Sheet", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
